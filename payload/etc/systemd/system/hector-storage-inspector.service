[Unit]
Description=Hector read-only data-folder size inspector
After=local-fs.target

[Service]
Type=simple
User=root
Group=debian
UMask=0027
RuntimeDirectory=hector-storage-inspector
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 -I -B /opt/hector-storage-manager/app/inspector.py
Restart=on-failure
RestartSec=10
Nice=19
IOSchedulingClass=idle
CPUQuota=5%
MemoryMax=64M
TasksMax=4
LimitNOFILE=64
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/hector-storage-inspector
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
