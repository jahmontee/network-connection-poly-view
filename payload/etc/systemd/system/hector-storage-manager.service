[Unit]
Requires=hector-storage-setup.service
After=hector-storage-setup.service
Description=Hector local storage and preset manager
After=local-fs.target network.target hector-module-catalog.service
Wants=hector-repository-fetch.socket hector-storage-inspector.service hector-remote-screen.service hector-module-catalog.service hector-module-restart.socket
After=hector-module-restart.socket
ConditionPathIsDirectory=/mnt/presets/beebo

[Service]
Type=simple
User=debian
Group=debian
UMask=0077
RuntimeDirectory=hector-storage-manager
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 -I -B /opt/hector-storage-manager/app/server.py --config /mnt/hector-storage-manager/config.json --listen 0.0.0.0:8787 --browser-password-file /mnt/hector-storage-manager/browser-access/password.json --remote-desktop-socket /run/hector-remote-screen/screen.sock --module-manager
Restart=on-failure
RestartSec=10
Nice=19
IOSchedulingClass=idle
CPUQuota=15%
MemoryMax=256M
TasksMax=12
LimitNOFILE=64
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/debian/UI
ReadOnlyPaths=/run/hector-storage-inspector -/run/hector-remote-screen
ReadWritePaths=/mnt/presets/beebo -/mnt/presets/digit /run/hector-storage-manager /mnt/hector-storage-manager/browser-access -/mnt/audio/reverbs -/mnt/audio/cabs -/mnt/audio/sample_box -/mnt/hector-storage-manager/modules
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressAllow=10.0.0.0/8
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.0.0/16

[Install]
WantedBy=multi-user.target
